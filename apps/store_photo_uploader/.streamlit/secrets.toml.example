# このファイルを secrets.toml にコピーして値を埋めてください。
# secrets.toml は .gitignore 済みです。絶対にコミットしないでください。

# 写真の保存先になる Google Drive フォルダの ID。
# フォルダの URL https://drive.google.com/drive/folders/XXXXXXXX の XXXXXXXX 部分。
DRIVE_FOLDER_ID = ""

# 書き込み先スプレッドシートの ID。
# URL https://docs.google.com/spreadsheets/d/XXXXXXXX/edit の XXXXXXXX 部分。
SPREADSHEET_ID = ""

# 対象シート名と列。
SHEET_NAME = "シート1"
STORE_NAME_COLUMN = "A"   # 店舗名が入っている列
LINK_COLUMN = "B"         # 共有リンクを書き込む列
FIRST_DATA_ROW = 2        # データが始まる行（ヘッダーが1行なら 2）

# "folder" = 店舗フォルダの共有リンクを書き込む（既定・複数枚に対応）
# "file"   = 写真1枚のときはそのファイルの共有リンクを書き込む
LINK_TARGET = "folder"

MAX_FILES = 10
MAX_FILE_MB = 20

# サービスアカウントの鍵 JSON の中身をそのまま貼り付ける。
[gcp_service_account]
type = "service_account"
project_id = ""
private_key_id = ""
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = ""
client_id = ""
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = ""
universe_domain = "googleapis.com"
